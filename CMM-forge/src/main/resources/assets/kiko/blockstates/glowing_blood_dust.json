   }
  },
  {
   "when": {
    "south": "side|up"
   },
   "apply": {
    "model": "kiko:block/blood_dust_side",
    "y": 180
   }
  },
  {
   "when": {
    "south": "up"
   },
   "apply": {
    "model": "kiko:block/blood_dust_up",
    "y": 180
   }
  },
  {
   "when": {
    "west": "side|up"
   },
   "apply": {
    "model": "kiko:block/blood_dust_side",
    "y": 270
   }
  },
  {
   "when": {
    "west": "up"
   },
